{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWeddingFolderOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET-NAME",
      "Condition": { "StringLike": { "s3:prefix": ["wedding/*"] } }
    },
    {
      "Sid": "ManageWeddingFolder",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET-NAME/wedding/*"
    }
  ]
}
